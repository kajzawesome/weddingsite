# RSVP → Google Sheet (see scripts/rsvp-apps-script.gs for setup)
# The Web app URL from Apps Script "Deploy > New deployment"
RSVP_SCRIPT_URL=
# Any long random string. Must match SECRET in the Apps Script.
RSVP_SECRET=

# Photo uploads (Cloudinary: Settings > API Keys)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# The code printed on table cards and built into the QR link. Pick something short, e.g. ROSES26
SHARE_CODE=

# Shared album (/gallery). The code guests type to see every photo.
# Leave empty to use SHARE_CODE, so the table card code opens both.
GALLERY_CODE=
# Your own code for /gallery/admin (hide photos, download backups). Make it long.
ADMIN_CODE=
